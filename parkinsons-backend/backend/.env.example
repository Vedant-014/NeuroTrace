# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Default: local SQLite file. For production, use Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./parkinsons_app.db

# --- JWT ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP ---
OTP_EXPIRE_MINUTES=10

# --- Google OAuth ---
# Create a project + OAuth Client ID (Web application) at:
# https://console.cloud.google.com/apis/credentials
# The frontend uses this same client ID for Google Sign-In and sends us the resulting id_token.
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
# For Gmail: enable 2FA on the account, then create an App Password at
# https://myaccount.google.com/apppasswords - use that here, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Leave EMAIL_ENABLED unset to auto-enable once SMTP_USER/SMTP_PASSWORD are set,
# or explicitly set to false to disable even with credentials present.
# EMAIL_ENABLED=true

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Rate limiting ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=60/minute

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend URL (used in email links) ---
FRONTEND_URL=http://localhost:5173
